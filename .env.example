# Copy to .env.local for local development, and add the same names in
# Netlify > Site configuration > Environment variables for the live site.
# Variables starting with VITE_ are public (they end up in the browser).
# The others are SECRET and must only ever live in Netlify / .env.local.

# ---------- Supabase (Project Settings > API) ----------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key          # SECRET

# ---------- Stripe (Developers > API keys / Webhooks) ----------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx                             # SECRET
STRIPE_WEBHOOK_SECRET=whsec_xxx                           # SECRET

# ---------- New-order email to the shop owner (optional, resend.com) ----------
RESEND_API_KEY=re_xxx                                     # SECRET
ADMIN_EMAIL=owner@example.com
# RESEND_FROM="Mari's Handmade <orders@yourdomain.co.uk>" # after verifying a domain in Resend
